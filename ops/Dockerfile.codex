FROM golang:1.24-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /agent ./cmd/codex-agent
FROM node:22-bookworm-slim
ARG CODEX_VERSION=0.169.0
RUN npm install -g @openai/codex@${CODEX_VERSION} && npm cache clean --force
COPY --from=builder /agent /agent
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH
ENV GOCACHE=/cache/go-build GOPATH=/cache/go-path GOTMPDIR=/cache/tmp npm_config_cache=/cache/npm
COPY ops/codex.config.toml /etc/codex/config.toml
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN ln -s /usr/local/go/bin/go /usr/bin/go && ln -s /usr/local/go/bin/gofmt /usr/bin/gofmt
RUN mkdir -p /workspace /state /cache/tmp && chown -R node:node /workspace /state /cache
USER node
ENV CODEX_HOME=/state
WORKDIR /workspace
ENTRYPOINT ["/agent"]
